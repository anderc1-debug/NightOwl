                                <Label text="Departs LIRR" styleClass="schedule-col-header" minWidth="160"/>
                                <Label text="Departs Nold Hall" styleClass="schedule-col-header" minWidth="160"/>
                                <Label text="Departs Aviation" styleClass="schedule-col-header" minWidth="160"/>
                            </HBox>
                            <Label text="Morning" styleClass="schedule-section-label"/>
